<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.paint.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.motivation.ChallengeController"
            style="-fx-background-color: linear-gradient(to bottom right, #0f0c29, #302b63, #24243e);">

    <!-- ================= TOP - HEADER PROFESSIONNEL ================= -->
    <top>
        <VBox spacing="0">
            <!-- Barre supérieure premium -->
            <HBox alignment="CENTER_LEFT" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 15 30;">
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Circle radius="20" fill="radial-gradient(center 50% 50%, radius 100%, #667eea, #764ba2)"/>
                    <VBox spacing="2">
                        <Label text="CHALLENGE MANAGER PRO"
                               style="-fx-font-size: 22px; -fx-font-weight: 900; -fx-text-fill: white; -fx-font-family: 'Segoe UI';"/>
                        <Label text="Système de gestion intelligente"
                               style="-fx-font-size: 11px; -fx-text-fill: #B4C6E7; -fx-font-family: 'Segoe UI Light';"/>
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Barre de recherche avec effet verre -->
                <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 25; -fx-padding: 8 20;">
                    <Label text="🔍" style="-fx-font-size: 16px; -fx-text-fill: rgba(255,255,255,0.7);"/>
                    <TextField fx:id="searchField"
                               promptText="Rechercher un challenge..."
                               style="-fx-background-color: transparent; -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.5);
                                      -fx-border-color: transparent; -fx-font-size: 14px; -fx-font-family: 'Segoe UI';"/>
                    <Button fx:id="searchBtn" text="FILTRER"
                            style="-fx-background-color: linear-gradient(to right, #4facfe, #00f2fe);
                                   -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;
                                   -fx-background-radius: 20; -fx-padding: 8 20;
                                   -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,242,254,0.3), 10, 0, 0, 3);"/>
                </HBox>
            </HBox>

            <!-- Barre d'actions -->
            <HBox spacing="20" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.2); -fx-padding: 12 30;">


                <Button fx:id="dashboardBtn" text="📊 DASHBOARD "
                        style="-fx-background-color: linear-gradient(to right, #11998e, #38ef7d);
                   -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;
                   -fx-background-radius: 20; -fx-padding: 10 25; -fx-cursor: hand;
                   -fx-effect: dropshadow(gaussian, rgba(56,239,125,0.4), 10, 0, 0, 4);"/>


                <Button fx:id="coachBtn" text="👨‍🏫 GESTION COACHES"
                        style="-fx-background-color: linear-gradient(to right, #8E2DE2, #4A00E0);
                               -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;
                               -fx-background-radius: 20; -fx-padding: 10 25; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(142,45,226,0.4), 10, 0, 0, 4);"/>

                <Button fx:id="recBtn" text="🎁 GESTION RÉCOMPENSES"
                        style="-fx-background-color: linear-gradient(to right, #f093fb, #f5576c);
                               -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;
                               -fx-background-radius: 20; -fx-padding: 10 25; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(245,87,108,0.4), 10, 0, 0, 4);"/>

                <Button fx:id="exportBtn" text="📊 EXPORTER RAPPORT"
                        style="-fx-background-color: linear-gradient(to right, #FA8BFF, #2BD2FF, #2BFF88);
                               -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;
                               -fx-background-radius: 20; -fx-padding: 10 25; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(43,210,255,0.5), 12, 0, 0, 5);"/>
            </HBox>
        </VBox>
    </top>

    <!-- ================= CENTER - CONTENU PRINCIPAL ================= -->
    <center>
        <GridPane hgap="20" vgap="20" style="-fx-padding: 25;">
            <columnConstraints>
                <ColumnConstraints percentWidth="65"/>
                <ColumnConstraints percentWidth="35"/>
            </columnConstraints>

            <!-- ========== COLONNE GAUCHE - LISTVIEW ET STATS ========== -->
            <VBox spacing="20" GridPane.columnIndex="0">
                <!-- Cartes statistiques modernes -->
                <GridPane hgap="15" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33"/>
                        <ColumnConstraints percentWidth="33"/>
                        <ColumnConstraints percentWidth="33"/>
                    </columnConstraints>

                    <!-- Carte Total -->
                    <!-- Carte Total -->
                    <!-- Carte Total -->
                    <VBox spacing="10" alignment="CENTER"
                          style="-fx-background-color: rgba(255,255,255,0.1);
             -fx-background-radius: 15; -fx-padding: 20;
             -fx-border-color: rgba(102,126,234,0.3); -fx-border-width: 1; -fx-border-radius: 15;"
                          GridPane.columnIndex="0">
                        <Label text="📊"
                               style="-fx-font-size: 28px; -fx-text-fill: #4DABF7;"/> <!-- Bleu -->
                        <Label text="TOTAL" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #B4C6E7;"/>
                        <Label fx:id="totalLabel" text="0"
                               style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                        <Label text="Challenges" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.7);"/>
                    </VBox>

                    <!-- Carte Actifs -->
                    <VBox spacing="10" alignment="CENTER"
                          style="-fx-background-color: rgba(17,153,142,0.15);
             -fx-background-radius: 15; -fx-padding: 20;
             -fx-border-color: rgba(56,239,125,0.3); -fx-border-width: 1; -fx-border-radius: 15;"
                          GridPane.columnIndex="1">
                        <Label text="✅"
                               style="-fx-font-size: 28px; -fx-text-fill: #00FF88;"/> <!-- Vert vif -->
                        <Label text="ACTIFS" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #B4C6E7;"/>
                        <Label fx:id="actifsLabel" text="0"
                               style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: #38ef7d;"/>
                        <Label text="En cours" style="-fx-font-size: 10px; -fx-text-fill: rgba(56,239,125,0.7);"/>
                    </VBox>

                    <!-- Carte Inactifs -->
                    <VBox spacing="10" alignment="CENTER"
                          style="-fx-background-color: rgba(238,9,121,0.15);
             -fx-background-radius: 15; -fx-padding: 20;
             -fx-border-color: rgba(255,106,0,0.3); -fx-border-width: 1; -fx-border-radius: 15;"
                          GridPane.columnIndex="2">
                        <Label text="❌"
                               style="-fx-font-size: 28px; -fx-text-fill: #FF6B6B;"/> <!-- Rouge vif -->
                        <Label text="INACTIFS" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #B4C6E7;"/>
                        <Label fx:id="inactifsLabel" text="0"
                               style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: #ff6a00;"/>
                        <Label text="Archivés" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,106,0,0.7);"/>
                    </VBox>
                </GridPane>

                <!-- En-tête de la liste amélioré -->
                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 0 10;">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="📋 CHALLENGES DISPONIBLES"
                               style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: white;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 2, 0, 1, 1);"/>
                        <Label text="Sélectionnez un challenge pour le modifier ou gérer ses coaches/récompenses"
                               style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);
                                      -fx-font-family: 'Segoe UI Light';"/>
                    </VBox>
                    <Label text="🔄" style="-fx-font-size: 24px; -fx-text-fill: #00f2fe; -fx-cursor: hand;
                                           -fx-effect: dropshadow(gaussian, rgba(0,242,254,0.5), 8, 0, 0, 2);"/>
                </HBox>

                <!-- Liste moderne des challenges - AMÉLIORÉE -->
                <VBox spacing="0" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: rgba(255,255,255,0.05);
                             -fx-background-radius: 15; -fx-border-color: rgba(255,255,255,0.15);
                             -fx-border-radius: 15; -fx-border-width: 2;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 15, 0, 0, 5);">

                    <!-- En-tête de la liste -->
                    <HBox alignment="CENTER" style="-fx-background-color: rgba(41,128,185,0.3);
                                                    -fx-background-radius: 15 15 0 0; -fx-padding: 15;">
                        <HBox spacing="20" alignment="CENTER">
                            <Label text="🏆" style="-fx-font-size: 22px;"/>
                            <VBox spacing="2">
                                <Label text="LISTE DES CHALLENGES"
                                       style="-fx-font-size: 16px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                                <Label text="Cliquez sur un élément pour afficher les détails"
                                       style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                            </VBox>
                        </HBox>
                    </HBox>

                    <!-- Séparateur décoratif -->
                    <Rectangle height="2" fill="linear-gradient(to right, transparent, #00f2fe, transparent)"
                               style="-fx-arc-width: 0; -fx-arc-height: 0;"/>

                    <!-- ListView améliorée -->
                    <ListView fx:id="challengeListView" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: transparent;
                                     -fx-background-insets: 0;
                                     -fx-padding: 10;
                                     -fx-border-width: 0;
                                     -fx-border-radius: 0;">
                        <!-- Style amélioré pour les cellules -->
                        <placeholder>
                            <VBox alignment="CENTER" spacing="15" style="-fx-padding: 40;">
                                <Label text="📭" style="-fx-font-size: 48px; -fx-text-fill: rgba(255,255,255,0.3);"/>
                                <Label text="Aucun challenge disponible"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.5);"/>
                                <Label text="Créez votre premier challenge pour commencer"
                                       style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.4);"/>
                                <Button text="➕ Créer un challenge"
                                        style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2);
                                               -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;
                                               -fx-background-radius: 20; -fx-padding: 10 20; -fx-cursor: hand;
                                               -fx-effect: dropshadow(gaussian, rgba(102,126,234,0.4), 10, 0, 0, 3);"/>
                            </VBox>
                        </placeholder>
                    </ListView>

                    <!-- Pied de la liste -->
                    <HBox alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.2);
                                                    -fx-background-radius: 0 0 15 15; -fx-padding: 10;">
                        <Label text="👆 Double-cliquez pour ouvrir les détails complets"
                               style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);
                                      -fx-font-style: italic;"/>
                    </HBox>
                </VBox>

                <!-- Mini statistiques -->
                <HBox spacing="15" alignment="CENTER" style="-fx-padding: 10;">
                    <HBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(52,152,219,0.2); -fx-background-radius: 10; -fx-padding: 5 15;">
                        <Label text="👤" style="-fx-font-size: 14px;"/>
                        <Label text="Coaches associés:" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                        <Label text="0" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2ECC71;"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(155,89,182,0.2); -fx-background-radius: 10; -fx-padding: 5 15;">
                        <Label text="🎁" style="-fx-font-size: 14px;"/>
                        <Label text="Récompenses:" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                        <Label text="0" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #F1C40F;"/>
                    </HBox>
                </HBox>
            </VBox>

            <!-- ========== COLONNE DROITE - FORMULAIRE ========== -->
            <VBox spacing="20" GridPane.columnIndex="1">
                <!-- Carte formulaire premium -->
                <VBox spacing="20" style="-fx-background-color: rgba(255,255,255,0.95);
                                        -fx-background-radius: 20; -fx-padding: 30;
                                        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 25, 0, 0, 8);">

                    <!-- En-tête formulaire -->
                    <VBox spacing="8">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Circle radius="5" fill="linear-gradient(to right, #667eea, #764ba2)"/>
                            <Label text="ÉDITION CHALLENGE"
                                   style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #2C3E50;"/>
                        </HBox>
                        <Label text="Créez ou modifiez un challenge en détail"
                               style="-fx-font-size: 11px; -fx-text-fill: #95A5A6;"/>
                    </VBox>

                    <Separator style="-fx-background-color: #E8EAF6;"/>

                    <!-- Formulaire -->
                    <VBox spacing="15">
                        <!-- Titre -->
                        <VBox spacing="5">
                            <Label text="Titre" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #34495E;"/>
                            <TextField fx:id="titleField" promptText="Ex: Maîtrise de Java en 30 jours"
                                       style="-fx-background-color: #F8F9FA; -fx-background-radius: 10;
                                              -fx-padding: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 10;
                                              -fx-border-width: 1.5; -fx-font-size: 13px;"/>
                        </VBox>

                        <!-- Description -->
                        <VBox spacing="5">
                            <Label text="Description" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #34495E;"/>
                            <TextArea fx:id="descField" promptText="Décrivez les objectifs..."
                                      prefHeight="80" wrapText="true"
                                      style="-fx-background-color: #F8F9FA; -fx-background-radius: 10;
                                             -fx-padding: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 10;
                                             -fx-border-width: 1.5; -fx-font-size: 13px;"/>
                        </VBox>

                        <!-- Grille paramètres -->
                        <!-- Grille paramètres -->
                        <GridPane hgap="10" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>

                            <!-- Design - Nouveau champ -->
                            <VBox spacing="5" GridPane.columnIndex="0">
                                <Label text="🎨 niveau de difficulté" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #34495E;"/>
                                <ComboBox fx:id="difficulteField" promptText="Sélectionner"
                                          style="-fx-background-color: #F8F9FA; -fx-background-radius: 10;
                         -fx-border-color: #E0E0E0; -fx-border-radius: 10;
                         -fx-border-width: 1.5; -fx-font-size: 13px;"/>
                            </VBox>

                            <!-- Durée -->
                            <VBox spacing="5" GridPane.columnIndex="1">
                                <Label text="⏱️ Durée (jours)" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #34495E;"/>
                                <TextField fx:id="dureeField" promptText="30"
                                           style="-fx-background-color: #F8F9FA; -fx-background-radius: 10;
                          -fx-padding: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10;
                          -fx-border-width: 1.5; -fx-font-size: 13px;"/>
                            </VBox>

                            <!-- Type -->
                            <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                  GridPane.columnSpan="2">
                                <Label text="📂 Type de challenge"
                                       style="-fx-font-size: 13px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #34495E;"/>
                                <ComboBox fx:id="typeField"
                                          prefWidth="420"
                                          promptText="Choisir une catégorie"
                                          style="-fx-background-color: #F8F9FA;
                                               -fx-background-radius: 12;
                                               -fx-border-color: #E0E0E0;
                                               -fx-border-radius: 12;
                                               -fx-border-width: 1.5;
                                               -fx-font-size: 13px;"/>
                            </VBox>

                        </GridPane>
                        <!-- Statut -->
                        <HBox spacing="10" alignment="CENTER_LEFT"
                              style="-fx-background-color: #F0F4F8; -fx-background-radius: 10; -fx-padding: 12;">
                            <Label text="⚡" style="-fx-font-size: 18px;"/>
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label text="Statut" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #34495E;"/>
                                <Label text="Activez pour rendre visible" style="-fx-font-size: 10px; -fx-text-fill: #7F8C8D;"/>
                            </VBox>
                            <CheckBox fx:id="actifField" text="Actif"
                                      style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                        </HBox>
                    </VBox>

                    <Separator style="-fx-background-color: #E8EAF6;"/>

                    <!-- Boutons d'actions -->
                    <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <Button fx:id="addBtn" text="➕ AJOUTER" maxWidth="Infinity"
                                GridPane.columnIndex="0" GridPane.rowIndex="0"
                                style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2);
                                       -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;
                                       -fx-background-radius: 10; -fx-padding: 12; -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian, rgba(102,126,234,0.3), 8, 0, 0, 3);"/>

                        <Button fx:id="updateBtn" text="✏️ MODIFIER" maxWidth="Infinity"
                                GridPane.columnIndex="1" GridPane.rowIndex="0"
                                style="-fx-background-color: linear-gradient(to right, #f093fb, #f5576c);
                                       -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;
                                       -fx-background-radius: 10; -fx-padding: 12; -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian, rgba(245,87,108,0.3), 8, 0, 0, 3);"/>

                        <Button fx:id="deleteBtn" text="🗑️ SUPPRIMER" maxWidth="Infinity"
                                GridPane.columnIndex="0" GridPane.rowIndex="1"
                                style="-fx-background-color: linear-gradient(to right, #ee0979, #ff6a00);
                                       -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;
                                       -fx-background-radius: 10; -fx-padding: 12; -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian, rgba(238,9,121,0.3), 8, 0, 0, 3);"/>

                        <Button fx:id="clearBtn" text="🔄 RÉINITIALISER" maxWidth="Infinity"
                                GridPane.columnIndex="1" GridPane.rowIndex="1"
                                style="-fx-background-color: linear-gradient(to right, #868f96, #596164);
                                       -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;
                                       -fx-background-radius: 10; -fx-padding: 12; -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian, rgba(89,97,100,0.3), 8, 0, 0, 3);"/>
                    </GridPane>
                </VBox>

                <!-- Carte informations -->
                <VBox spacing="12" style="-fx-background-color: linear-gradient(to right, #ffecd2, #fcb69f);
                                         -fx-background-radius: 15; -fx-padding: 20;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 12, 0, 0, 4);">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="💡" style="-fx-font-size: 22px;"/>
                        <Label text="CONSEIL PRO" style="-fx-font-size: 14px; -fx-font-weight: 900; -fx-text-fill: #7B3F00;"/>
                    </HBox>
                    <Label text="Les descriptions détaillées augmentent l'engagement des participants de 40%. Incluez des objectifs clairs et des étapes mesurables."
                           wrapText="true" style="-fx-font-size: 11px; -fx-text-fill: #8B4513; -fx-line-spacing: 3px;"/>
                </VBox>
            </VBox>
        </GridPane>
    </center>

    <!-- ================= BOTTOM - FOOTER ================= -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.3); -fx-padding: 10;">
            <Label text="© 2024 Challenge Manager Pro - Système de Gestion Avancée | Interface Professionnelle Réactive"
                   style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.5);"/>
        </HBox>
    </bottom>

</BorderPane>