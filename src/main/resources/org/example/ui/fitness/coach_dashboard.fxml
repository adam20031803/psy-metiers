<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.fitness.CoachDashboardController"
            stylesheets="@styles.css"
            style="-fx-background-color: linear-gradient(to bottom right, #0a0820, #1a1535, #0f0c29, #302b63);">

    <top>
        <VBox spacing="0">
            <!-- Title Bar -->
            <HBox alignment="CENTER_LEFT" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 24 40; -fx-border-color: rgba(103,128,255,0.25); -fx-border-width: 0 0 1 0;">
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <StackPane>
                        <Circle radius="28" style="-fx-fill: radial-gradient(center 50% 50%, radius 100%, #ff8e53, #ff6b6b); -fx-effect: dropshadow(gaussian, rgba(255,142,83,0.6), 20, 0, 0, 0);"/>
                        <Label text="🏋️" style="-fx-font-size: 22px;"/>
                    </StackPane>
                    <VBox spacing="4">
                        <Label text="COACH DASHBOARD"
                               style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-letter-spacing: 1px;"/>
                        <Label text="Assign Workouts • Sort • Search • Export PDF"
                               style="-fx-font-size: 12.5px; -fx-text-fill: #ff8e53; -fx-font-family: 'Segoe UI'; -fx-font-weight: 500;"/>
                    </VBox>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="12" alignment="CENTER">
                    <Button fx:id="manageWorkoutsBtn" text="🛠️ MANAGE WORKOUTS"
                            style="-fx-background-color: linear-gradient(to bottom right, #6780ff 0%, #5678e9 100%); -fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 12.5px; -fx-background-radius: 28; -fx-padding: 12 24; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(103,128,255,0.6), 15, 0, 0, 4);"/>
                    <Button fx:id="exportPdfBtn" text="📄 EXPORT PDF"
                            style="-fx-background-color: linear-gradient(to bottom right, #ff5252 0%, #d32f2f 100%); -fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 12.5px; -fx-background-radius: 28; -fx-padding: 12 24; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(255,82,82,0.6), 15, 0, 0, 4);"/>
                    <Button fx:id="backBtn" text="🏠 BACK TO HUB"
                            style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-weight: 700; -fx-font-size: 12.5px; -fx-background-radius: 28; -fx-padding: 12 28; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1.5;"/>
                </HBox>
            </HBox>

            <!-- Search + Sort Bar -->
            <HBox alignment="CENTER_LEFT" spacing="16"
                  style="-fx-background-color: rgba(255,255,255,0.04); -fx-padding: 14 40; -fx-border-color: rgba(255,142,83,0.12); -fx-border-width: 0 0 1 0;">

                <!-- Search Section -->
                <Label text="🔍" style="-fx-font-size: 16px;"/>
                <ComboBox fx:id="searchByCombo" promptText="Search by..."
                          style="-fx-pref-height: 36px; -fx-pref-width: 120;"/>
                <TextField fx:id="searchField" promptText="Type to search..."
                           style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.35); -fx-font-size: 13px; -fx-background-radius: 14; -fx-padding: 10 18; -fx-border-color: rgba(255,142,83,0.25); -fx-border-radius: 14; -fx-border-width: 1; -fx-pref-width: 300;"/>

                <Separator orientation="VERTICAL" style="-fx-background-color: rgba(255,255,255,0.15);"/>

                <!-- Sort Section -->
                <Label text="↕️ Sort:"
                       style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.6); -fx-font-weight: 700;"/>
                <ComboBox fx:id="sortByCombo" promptText="Sort by..."
                          style="-fx-pref-height: 36px; -fx-pref-width: 160;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <HBox spacing="24" style="-fx-padding: 28;">

                <!-- Left: Plans Table (wider) -->
                <VBox spacing="14" HBox.hgrow="ALWAYS" style="-fx-min-width: 500;">
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 0 6;">
                        <StackPane>
                            <Circle radius="18" style="-fx-fill: linear-gradient(to bottom right, #ff8e53, #ff6b6b); -fx-effect: dropshadow(gaussian, rgba(255,142,83,0.4), 8, 0, 0, 0);"/>
                            <Label text="📋" style="-fx-font-size: 12px;"/>
                        </StackPane>
                        <VBox spacing="2">
                            <Label text="Assigned Plans"
                                   style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                            <Label text="Click a row to edit • PDF exports what you see"
                                   style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.45);"/>
                        </VBox>
                    </HBox>

                    <TableView fx:id="planTable" prefHeight="420" minHeight="250"
                               style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 16;">
                        <columns>
                            <TableColumn fx:id="planIdCol" text="ID" prefWidth="50" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="planClientCol" text="CLIENT" prefWidth="130"/>
                            <TableColumn fx:id="planWorkoutCol" text="WORKOUT" prefWidth="140"/>
                            <TableColumn fx:id="planDayCol" text="DAY" prefWidth="95" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="planNotesCol" text="NOTES" prefWidth="130"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- Right: Assignment Form -->
                <VBox spacing="20" prefWidth="320" minWidth="290" maxWidth="360"
                      style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 20; -fx-padding: 28; -fx-border-color: linear-gradient(to bottom, rgba(255,142,83,0.4), rgba(103,128,255,0.3)); -fx-border-width: 2; -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 22, 0, 0, 8);">

                    <VBox spacing="10">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <StackPane>
                                <Circle radius="7" style="-fx-fill: linear-gradient(to right, #ff8e53, #6780ff);"/>
                            </StackPane>
                            <Label text="Assign Workout"
                                   style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                        </HBox>
                        <Separator style="-fx-background-color: linear-gradient(to right, rgba(255,142,83,0.4), rgba(103,128,255,0.4));"/>
                    </VBox>

                    <VBox spacing="16">
                        <VBox spacing="6">
                            <Label text="CLIENT" style="-fx-font-size: 10px; -fx-font-weight: 800; -fx-text-fill: #ff8e53; -fx-letter-spacing: 1px;"/>
                            <ComboBox fx:id="clientCombo" promptText="Select client" maxWidth="Infinity"
                                      style="-fx-pref-height: 38px;"/>
                        </VBox>

                        <VBox spacing="6">
                            <Label text="WORKOUT" style="-fx-font-size: 10px; -fx-font-weight: 800; -fx-text-fill: #ff8e53; -fx-letter-spacing: 1px;"/>
                            <ComboBox fx:id="workoutCombo" promptText="Select workout" maxWidth="Infinity"
                                      style="-fx-pref-height: 38px;"/>
                        </VBox>

                        <VBox spacing="6">
                            <Label text="DAY OF WEEK" style="-fx-font-size: 10px; -fx-font-weight: 800; -fx-text-fill: #ff8e53; -fx-letter-spacing: 1px;"/>
                            <ComboBox fx:id="dayCombo" promptText="Select day" maxWidth="Infinity"
                                      style="-fx-pref-height: 38px;"/>
                        </VBox>

                        <VBox spacing="6">
                            <Label text="NOTES" style="-fx-font-size: 10px; -fx-font-weight: 800; -fx-text-fill: #ff8e53; -fx-letter-spacing: 1px;"/>
                            <TextArea fx:id="notesField" promptText="Optional notes..." wrapText="true" prefRowCount="2"
                                      style="-fx-font-size: 13px;"/>
                        </VBox>
                    </VBox>

                    <Separator style="-fx-background-color: linear-gradient(to right, rgba(255,142,83,0.3), rgba(103,128,255,0.3));"/>

                    <!-- Buttons -->
                    <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <Button fx:id="assignBtn" text="➕ ASSIGN" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                style="-fx-background-color: linear-gradient(to bottom right, #ff8e53 0%, #ff6b6b 100%); -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 12; -fx-padding: 13; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(255,142,83,0.5), 10, 0, 0, 3); -fx-font-size: 12px;"/>
                        <Button fx:id="updateBtn" text="✏️ UPDATE" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"
                                style="-fx-background-color: linear-gradient(to bottom right, #6780ff 0%, #5678e9 100%); -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 12; -fx-padding: 13; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(103,128,255,0.5), 10, 0, 0, 3); -fx-font-size: 12px;"/>
                        <Button fx:id="deleteBtn" text="🗑️ DELETE" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                style="-fx-background-color: linear-gradient(to bottom right, #ff5252 0%, #d32f2f 100%); -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 12; -fx-padding: 13; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(255,82,82,0.5), 10, 0, 0, 3); -fx-font-size: 12px;"/>
                        <Button fx:id="clearBtn" text="🔄 CLEAR" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-weight: 700; -fx-background-radius: 12; -fx-padding: 13; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1.5; -fx-border-radius: 12; -fx-font-size: 12px;"/>
                    </GridPane>
                </VBox>
            </HBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="8" style="-fx-background-color: rgba(0,0,0,0.4); -fx-padding: 14; -fx-border-color: rgba(255,142,83,0.1); -fx-border-width: 1 0 0 0;">
            <Label text="🏋️" style="-fx-font-size: 12px; -fx-text-fill: #ff8e53;"/>
            <Label text="Coach Dashboard v2 • Sort • Search • PDF Export"
                   style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.4); -fx-font-weight: 500;"/>
        </HBox>
    </bottom>
</BorderPane>
