<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.fitness.WorkoutHistoryController"
            stylesheets="@styles.css"
            style="-fx-background-color: linear-gradient(to bottom right, #0a0820, #1a1535, #0f0c29, #302b63);">

    <top>
        <VBox spacing="0">
            <HBox alignment="CENTER_LEFT" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 24 40; -fx-border-color: rgba(0,255,198,0.15); -fx-border-width: 0 0 1 0;">
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <StackPane>
                        <Circle radius="28" style="-fx-fill: radial-gradient(center 50% 50%, radius 100%, #00ffc6, #00c9a7); -fx-effect: dropshadow(gaussian, rgba(0,255,198,0.6), 20, 0, 0, 0);"/>
                        <Label text="📊" style="-fx-font-size: 22px;"/>
                    </StackPane>
                    <VBox spacing="4">
                        <Label text="WORKOUT HISTORY"
                               style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-letter-spacing: 1px;"/>
                        <Label text="Review • Edit • Track Your Progress"
                               style="-fx-font-size: 12.5px; -fx-text-fill: #00ffc6; -fx-font-family: 'Segoe UI'; -fx-font-weight: 500;"/>
                    </VBox>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="14" alignment="CENTER">
                    <HBox spacing="8" alignment="CENTER" style="-fx-background-color: linear-gradient(to bottom right, rgba(0,201,167,0.2), rgba(0,255,198,0.15)); -fx-background-radius: 18; -fx-padding: 10 18; -fx-border-color: rgba(0,255,198,0.3); -fx-border-width: 1; -fx-border-radius: 18;">
                        <Label text="Total:" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.7); -fx-font-weight: 600;"/>
                        <Label fx:id="totalLabel" text="0"
                               style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #00ffc6;"/>
                    </HBox>
                    <Button fx:id="backBtn" text="🏠 BACK TO HUB"
                            style="-fx-background-color: linear-gradient(to bottom right, #00c9a7 0%, #00ffc6 100%); -fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 12.5px; -fx-background-radius: 28; -fx-padding: 12 28; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,201,167,0.6), 15, 0, 0, 4);"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <GridPane hgap="30" vgap="30" style="-fx-padding: 35;">
                <columnConstraints>
                    <ColumnConstraints percentWidth="60"/>
                    <ColumnConstraints percentWidth="40"/>
                </columnConstraints>

                <!-- Left: History Table -->
                <VBox spacing="18" GridPane.columnIndex="0">
                    <HBox alignment="CENTER_LEFT" spacing="14" style="-fx-padding: 0 8;">
                        <StackPane>
                            <Circle radius="22" style="-fx-fill: linear-gradient(to bottom right, #00c9a7, #00ffc6); -fx-effect: dropshadow(gaussian, rgba(0,255,198,0.4), 10, 0, 0, 0);"/>
                            <Label text="📋" style="-fx-font-size: 15px;"/>
                        </StackPane>
                        <VBox spacing="2">
                            <Label text="Completed Sessions"
                                   style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: white; -fx-letter-spacing: 0.5px;"/>
                            <Label text="Your full workout completion history"
                                   style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.5);"/>
                        </VBox>
                    </HBox>

                    <TableView fx:id="historyTable" prefHeight="400" minHeight="250"
                               style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 18;">
                        <columns>
                            <TableColumn fx:id="histIdCol" text="ID" prefWidth="50" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="histWorkoutCol" text="WORKOUT" prefWidth="170"/>
                            <TableColumn fx:id="histDateCol" text="DATE" prefWidth="110" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="histRatingCol" text="RATING" prefWidth="80" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="histStreakCol" text="STREAK" prefWidth="70" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="histNotesCol" text="NOTES" prefWidth="160"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- Right: Edit Form -->
                <VBox spacing="24" GridPane.columnIndex="1"
                      style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 22; -fx-padding: 32; -fx-border-color: linear-gradient(to bottom, rgba(0,201,167,0.4), rgba(103,128,255,0.3)); -fx-border-width: 2; -fx-border-radius: 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 25, 0, 0, 10);">

                    <VBox spacing="12">
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <StackPane>
                                <Circle radius="8" style="-fx-fill: linear-gradient(to right, #00ffc6, #6780ff);"/>
                            </StackPane>
                            <Label text="Edit Entry"
                                   style="-fx-font-size: 22px; -fx-font-weight: 900; -fx-text-fill: white; -fx-letter-spacing: 0.5px;"/>
                        </HBox>
                        <Separator style="-fx-background-color: linear-gradient(to right, rgba(0,255,198,0.4), rgba(103,128,255,0.4));"/>
                    </VBox>

                    <VBox spacing="18">
                        <!-- Date -->
                        <VBox spacing="8">
                            <Label text="COMPLETION DATE" style="-fx-font-size: 10.5px; -fx-font-weight: 800; -fx-text-fill: #00ffc6; -fx-letter-spacing: 1px;"/>
                            <DatePicker fx:id="datePicker" maxWidth="Infinity"
                                        style="-fx-font-size: 13px; -fx-pref-height: 42px;"/>
                        </VBox>

                        <!-- Rating -->
                        <VBox spacing="8">
                            <Label text="RATING" style="-fx-font-size: 10.5px; -fx-font-weight: 800; -fx-text-fill: #00ffc6; -fx-letter-spacing: 1px;"/>
                            <ComboBox fx:id="ratingCombo" maxWidth="Infinity"
                                      style="-fx-font-size: 13px; -fx-pref-height: 42px;"/>
                        </VBox>

                        <!-- Notes -->
                        <VBox spacing="8">
                            <Label text="NOTES" style="-fx-font-size: 10.5px; -fx-font-weight: 800; -fx-text-fill: #00ffc6; -fx-letter-spacing: 1px;"/>
                            <TextArea fx:id="notesField" promptText="How did it go? Add notes here..." wrapText="true" prefRowCount="3"
                                      style="-fx-font-size: 13px;"/>
                        </VBox>
                    </VBox>

                    <Separator style="-fx-background-color: linear-gradient(to right, rgba(0,255,198,0.3), rgba(103,128,255,0.3));"/>

                    <!-- Buttons -->
                    <VBox spacing="14">
                        <Button fx:id="updateBtn" text="✏️ UPDATE ENTRY" maxWidth="Infinity"
                                style="-fx-background-color: linear-gradient(to bottom right, #6780ff 0%, #5678e9 100%); -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 14; -fx-padding: 15; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(103,128,255,0.5), 12, 0, 0, 3); -fx-font-size: 12.5px;"/>
                        <Button fx:id="deleteBtn" text="🗑️ DELETE ENTRY" maxWidth="Infinity"
                                style="-fx-background-color: linear-gradient(to bottom right, #ff6b6b 0%, #ff5252 100%); -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 14; -fx-padding: 15; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(255,107,107,0.5), 12, 0, 0, 3); -fx-font-size: 12.5px;"/>
                        <Button fx:id="clearBtn" text="🔄 CLEAR" maxWidth="Infinity"
                                style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-weight: 700; -fx-background-radius: 14; -fx-padding: 15; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1.5; -fx-border-radius: 14; -fx-font-size: 12.5px;"/>
                    </VBox>

                    <!-- Tips -->
                    <VBox spacing="10" style="-fx-background-color: linear-gradient(to bottom right, rgba(103,128,255,0.15), rgba(0,201,167,0.1)); -fx-background-radius: 14; -fx-padding: 16 18; -fx-border-color: rgba(103,128,255,0.25); -fx-border-width: 1; -fx-border-radius: 14;">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="💡" style="-fx-font-size: 14px;"/>
                            <Label text="Tips" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #a5b4ff;"/>
                        </HBox>
                        <Label text="• Select an entry from the table to edit
• You can change the date or add notes
• Deleting an entry will affect your streak"
                               wrapText="true"
                               style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.6); -fx-line-spacing: 3px;"/>
                    </VBox>
                </VBox>
            </GridPane>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="8" style="-fx-background-color: rgba(0,0,0,0.4); -fx-padding: 14; -fx-border-color: rgba(0,255,198,0.1); -fx-border-width: 1 0 0 0;">
            <Label text="📊" style="-fx-font-size: 12px; -fx-text-fill: #00ffc6;"/>
            <Label text="Workout History v1.0 • Progress Tracking System"
                   style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.4); -fx-font-weight: 500;"/>
        </HBox>
    </bottom>
</BorderPane>
