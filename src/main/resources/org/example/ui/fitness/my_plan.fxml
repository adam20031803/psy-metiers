<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.fitness.MyPlanController"
            stylesheets="@styles.css"
            style="-fx-background-color: linear-gradient(to bottom right, #0a0820, #1a1535, #0f0c29, #302b63);">

    <top>
        <VBox spacing="0">
            <HBox alignment="CENTER_LEFT" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 24 40; -fx-border-color: rgba(0,255,198,0.15); -fx-border-width: 0 0 1 0;">
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <StackPane>
                        <Circle radius="28" style="-fx-fill: radial-gradient(center 50% 50%, radius 100%, #00ffc6, #00c9a7); -fx-effect: dropshadow(gaussian, rgba(0,255,198,0.6), 20, 0, 0, 0);"/>
                        <Label text="🎯" style="-fx-font-size: 22px;"/>
                    </StackPane>
                    <VBox spacing="4">
                        <Label text="MY WORKOUT PLAN"
                               style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-letter-spacing: 1px;"/>
                        <Label text="Your Personalized Training Schedule"
                               style="-fx-font-size: 12.5px; -fx-text-fill: #00ffc6; -fx-font-family: 'Segoe UI'; -fx-font-weight: 500;"/>
                    </VBox>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="backBtn" text="🏠 BACK TO HUB"
                        style="-fx-background-color: linear-gradient(to bottom right, #00c9a7 0%, #00ffc6 100%); -fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 12.5px; -fx-background-radius: 28; -fx-padding: 12 28; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,201,167,0.6), 15, 0, 0, 4);"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background-insets: 0;">
            <VBox spacing="28" style="-fx-padding: 35;">

                <!-- Motivational Banner -->
                <VBox spacing="16" alignment="CENTER"
                      style="-fx-background-color: linear-gradient(to bottom right, rgba(0,201,167,0.18), rgba(103,128,255,0.18)); -fx-background-radius: 24; -fx-padding: 32; -fx-border-color: linear-gradient(to right, rgba(0,255,198,0.4), rgba(103,128,255,0.4)); -fx-border-width: 2; -fx-border-radius: 24; -fx-effect: dropshadow(gaussian, rgba(0,255,198,0.2), 25, 0, 0, 10);">
                    <Label text="🌟" style="-fx-font-size: 36px;"/>
                    <Label fx:id="motivationLabel"
                           text="Loading motivation..."
                           wrapText="true"
                           style="-fx-font-size: 16px; -fx-text-fill: white; -fx-font-style: italic; -fx-font-weight: 500; -fx-text-alignment: center;"/>
                </VBox>

                <!-- Stats Row -->
                <HBox spacing="20" alignment="CENTER">
                    <!-- Today's Day -->
                    <VBox spacing="6" alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 20; -fx-padding: 24; -fx-border-color: linear-gradient(to bottom, rgba(0,255,198,0.5), rgba(0,201,167,0.3)); -fx-border-width: 2; -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,255,198,0.2), 15, 0, 0, 6);">
                        <Label text="📅" style="-fx-font-size: 20px;"/>
                        <Label fx:id="dayLabel" text="..."
                               style="-fx-font-size: 22px; -fx-font-weight: 900; -fx-text-fill: #00ffc6;"/>
                        <Label fx:id="dateLabel" text="..."
                               style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    </VBox>

                    <!-- Today's Count -->
                    <VBox spacing="6" alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 20; -fx-padding: 24; -fx-border-color: linear-gradient(to bottom, rgba(255,107,107,0.5), rgba(255,82,82,0.3)); -fx-border-width: 2; -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(255,82,82,0.2), 15, 0, 0, 6);">
                        <Label text="🎯" style="-fx-font-size: 20px;"/>
                        <Label fx:id="todayCountLabel" text="0"
                               style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: #ff6b6b;"/>
                        <Label text="TODAY'S WORKOUTS"
                               style="-fx-font-size: 10px; -fx-font-weight: 800; -fx-text-fill: rgba(255,255,255,0.5); -fx-letter-spacing: 1px;"/>
                    </VBox>

                    <!-- Completed Today -->
                    <VBox spacing="6" alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 20; -fx-padding: 24; -fx-border-color: linear-gradient(to bottom, rgba(103,128,255,0.5), rgba(86,120,233,0.3)); -fx-border-width: 2; -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(103,128,255,0.2), 15, 0, 0, 6);">
                        <Label text="✅" style="-fx-font-size: 20px;"/>
                        <Label fx:id="completedTodayLabel" text="0"
                               style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: #6780ff;"/>
                        <Label text="COMPLETED TODAY"
                               style="-fx-font-size: 10px; -fx-font-weight: 800; -fx-text-fill: rgba(255,255,255,0.5); -fx-letter-spacing: 1px;"/>
                    </VBox>

                    <!-- Week Total -->
                    <VBox spacing="6" alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 20; -fx-padding: 24; -fx-border-color: linear-gradient(to bottom, rgba(255,142,83,0.5), rgba(255,107,107,0.3)); -fx-border-width: 2; -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(255,142,83,0.2), 15, 0, 0, 6);">
                        <Label text="📊" style="-fx-font-size: 20px;"/>
                        <Label fx:id="weekTotalLabel" text="0"
                               style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: #ff8e53;"/>
                        <Label text="WEEKLY SESSIONS"
                               style="-fx-font-size: 10px; -fx-font-weight: 800; -fx-text-fill: rgba(255,255,255,0.5); -fx-letter-spacing: 1px;"/>
                    </VBox>
                </HBox>

                <!-- Today's Workouts Section -->
                <VBox spacing="16">
                    <HBox spacing="14" alignment="CENTER_LEFT" style="-fx-padding: 0 8;">
                        <StackPane>
                            <Circle radius="22" style="-fx-fill: linear-gradient(to bottom right, #ff6b6b, #ff8e53); -fx-effect: dropshadow(gaussian, rgba(255,107,107,0.4), 10, 0, 0, 0);"/>
                            <Label text="🔥" style="-fx-font-size: 15px;"/>
                        </StackPane>
                        <VBox spacing="2">
                            <Label text="TODAY'S TRAINING"
                                   style="-fx-font-size: 22px; -fx-font-weight: 900; -fx-text-fill: white; -fx-letter-spacing: 0.5px;"/>
                            <Label text="Complete these workouts to keep your streak alive!"
                                   style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.5);"/>
                        </VBox>
                    </HBox>

                    <!-- Dynamic workout cards inserted here -->
                    <VBox fx:id="todayWorkoutsContainer" spacing="18" style="-fx-padding: 4 0;"/>
                </VBox>

                <!-- Weekly Plan Overview -->
                <VBox spacing="16">
                    <HBox spacing="14" alignment="CENTER_LEFT" style="-fx-padding: 0 8;">
                        <StackPane>
                            <Circle radius="22" style="-fx-fill: linear-gradient(to bottom right, #6780ff, #5678e9); -fx-effect: dropshadow(gaussian, rgba(103,128,255,0.4), 10, 0, 0, 0);"/>
                            <Label text="📅" style="-fx-font-size: 15px;"/>
                        </StackPane>
                        <VBox spacing="2">
                            <Label text="WEEKLY OVERVIEW"
                                   style="-fx-font-size: 22px; -fx-font-weight: 900; -fx-text-fill: white; -fx-letter-spacing: 0.5px;"/>
                            <Label text="Your full 7-day workout schedule"
                                   style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.5);"/>
                        </VBox>
                    </HBox>

                    <!-- Dynamic week rows inserted here -->
                    <VBox fx:id="weekPlanContainer" spacing="8" style="-fx-padding: 4 0;"/>
                </VBox>

                <!-- Motivational Footer -->
                <HBox alignment="CENTER" style="-fx-background-color: linear-gradient(to right, rgba(255,107,107,0.12), rgba(255,142,83,0.12), rgba(0,201,167,0.12)); -fx-background-radius: 18; -fx-padding: 20 28; -fx-border-color: rgba(255,142,83,0.2); -fx-border-width: 1; -fx-border-radius: 18;">
                    <Label text="💪 Consistency is key! Show up every day, even when you don't feel like it. Small steps lead to big changes."
                           wrapText="true"
                           style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.65); -fx-font-weight: 500; -fx-font-style: italic;"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="8" style="-fx-background-color: rgba(0,0,0,0.4); -fx-padding: 14; -fx-border-color: rgba(0,255,198,0.1); -fx-border-width: 1 0 0 0;">
            <Label text="🎯" style="-fx-font-size: 12px; -fx-text-fill: #00ffc6;"/>
            <Label text="My Plan v1.0 • Personalized Training System"
                   style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.4); -fx-font-weight: 500;"/>
        </HBox>
    </bottom>
</BorderPane>
