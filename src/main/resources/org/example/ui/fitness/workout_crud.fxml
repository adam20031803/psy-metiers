<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.effect.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.fitness.WorkoutController"
            stylesheets="@styles.css"
            style="-fx-background-color: linear-gradient(to bottom right, #0a0820, #1a1535, #0f0c29, #302b63);">

    <top>
        <VBox spacing="0">
            <!-- Enhanced Header -->
            <HBox alignment="CENTER_LEFT" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 24 40; -fx-border-color: rgba(0,255,198,0.15); -fx-border-width: 0 0 1 0;">
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <!-- Logo -->
                    <StackPane>
                        <Circle radius="28" style="-fx-fill: radial-gradient(center 50% 50%, radius 100%, #6780ff, #5678e9); -fx-effect: dropshadow(gaussian, rgba(103,128,255,0.6), 20, 0, 0, 0);"/>
                        <Label text="⚙️" style="-fx-font-size: 22px;"/>
                    </StackPane>
                    <VBox spacing="4">
                        <Label text="WORKOUT STUDIO" 
                               style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-letter-spacing: 1px;"/>
                        <Label text="Design Your Perfect Training Templates" 
                               style="-fx-font-size: 12.5px; -fx-text-fill: #a5b4ff; -fx-font-family: 'Segoe UI'; -fx-font-weight: 500;"/>
                    </VBox>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="dashboardBtn" text="🏠 BACK TO DASHBOARD"
                        style="-fx-background-color: linear-gradient(to bottom right, #00c9a7 0%, #00ffc6 100%); -fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 12.5px; -fx-background-radius: 28; -fx-padding: 12 28; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,201,167,0.6), 15, 0, 0, 4); -fx-letter-spacing: 0.5px;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <GridPane hgap="30" vgap="30" style="-fx-padding: 35;">
                <columnConstraints>
                    <ColumnConstraints percentWidth="58"/>
                    <ColumnConstraints percentWidth="42"/>
                </columnConstraints>

                <!-- Left: Enhanced Table View -->
                <VBox spacing="18" GridPane.columnIndex="0">
                    <!-- Table Header -->
                    <HBox alignment="CENTER_LEFT" spacing="14" style="-fx-padding: 0 8;">
                        <StackPane>
                            <Circle radius="22" style="-fx-fill: linear-gradient(to bottom right, #00c9a7, #00ffc6); -fx-effect: dropshadow(gaussian, rgba(0,255,198,0.4), 10, 0, 0, 0);"/>
                            <Label text="📋" style="-fx-font-size: 15px;"/>
                        </StackPane>
                        <VBox spacing="2">
                            <Label text="Workout Library" 
                                   style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: white; -fx-letter-spacing: 0.5px;"/>
                            <Label text="All your training templates in one place"
                                   style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.5);"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox spacing="8" alignment="CENTER" style="-fx-background-color: linear-gradient(to bottom right, rgba(0,201,167,0.2), rgba(0,255,198,0.15)); -fx-background-radius: 18; -fx-padding: 10 18; -fx-border-color: rgba(0,255,198,0.3); -fx-border-width: 1; -fx-border-radius: 18;">
                            <Label text="Total:" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.7); -fx-font-weight: 600;"/>
                            <Label fx:id="workoutCountLabel" text="0" 
                                   style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #00ffc6;"/>
                        </HBox>
                    </HBox>
                    
                    <!-- Table with fixed height (no VBox.vgrow to avoid empty rows) -->
                    <TableView fx:id="workoutTable" prefHeight="280" minHeight="180"
                               style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 18;">
                        <columns>
                            <TableColumn fx:id="idColumn" text="ID" prefWidth="50" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="titleColumn" text="WORKOUT TITLE" prefWidth="160"/>
                            <TableColumn fx:id="categoryColumn" text="CATEGORY" prefWidth="100" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="durationColumn" text="DURATION" prefWidth="85" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="difficultyColumn" text="LEVEL" prefWidth="90" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="createdAtColumn" text="CREATED" prefWidth="130"/>
                        </columns>
                    </TableView>
                    
                    <!-- Quick Stats Row -->
                    <HBox spacing="15" alignment="CENTER">
                        <VBox spacing="6" alignment="CENTER" style="-fx-background-color: rgba(255,107,107,0.15); -fx-background-radius: 14; -fx-padding: 12 20; -fx-border-color: rgba(255,107,107,0.3); -fx-border-width: 1; -fx-border-radius: 14;" HBox.hgrow="ALWAYS">
                            <Label text="🔥 Strength" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.6);"/>
                            <Label fx:id="strengthCountLabel" text="0" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #ff6b6b;"/>
                        </VBox>
                        <VBox spacing="6" alignment="CENTER" style="-fx-background-color: rgba(0,201,167,0.15); -fx-background-radius: 14; -fx-padding: 12 20; -fx-border-color: rgba(0,201,167,0.3); -fx-border-width: 1; -fx-border-radius: 14;" HBox.hgrow="ALWAYS">
                            <Label text="🏃 Cardio" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.6);"/>
                            <Label fx:id="cardioCountLabel" text="0" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #00ffc6;"/>
                        </VBox>
                        <VBox spacing="6" alignment="CENTER" style="-fx-background-color: rgba(103,128,255,0.15); -fx-background-radius: 14; -fx-padding: 12 20; -fx-border-color: rgba(103,128,255,0.3); -fx-border-width: 1; -fx-border-radius: 14;" HBox.hgrow="ALWAYS">
                            <Label text="🧘 Flexibility" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.6);"/>
                            <Label fx:id="flexibilityCountLabel" text="0" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #6780ff;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Right: Enhanced Form -->
                <VBox spacing="24" GridPane.columnIndex="1"
                      style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 22; -fx-padding: 32; -fx-border-color: linear-gradient(to bottom, rgba(0,201,167,0.4), rgba(103,128,255,0.3)); -fx-border-width: 2; -fx-border-radius: 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 25, 0, 0, 10);">
                    
                    <!-- Form Header -->
                    <VBox spacing="12">
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <StackPane>
                                <Circle radius="8" style="-fx-fill: linear-gradient(to right, #00ffc6, #6780ff);"/>
                            </StackPane>
                            <Label text="Workout Builder"
                                   style="-fx-font-size: 22px; -fx-font-weight: 900; -fx-text-fill: white; -fx-letter-spacing: 0.5px;"/>
                        </HBox>
                        <Separator style="-fx-background-color: linear-gradient(to right, rgba(0,255,198,0.4), rgba(103,128,255,0.4));"/>
                    </VBox>
                    
                    <!-- Form Fields -->
                    <VBox spacing="18">
                        <!-- Title Field -->
                        <VBox spacing="8">
                            <Label text="WORKOUT TITLE" style="-fx-font-size: 10.5px; -fx-font-weight: 800; -fx-text-fill: #00ffc6; -fx-letter-spacing: 1px;"/>
                            <TextField fx:id="titleField" promptText="e.g., Morning Power Routine"
                                        style="-fx-font-size: 13.5px; -fx-padding: 14 18;"/>
                        </VBox>
                        
                        <!-- Description Field -->
                        <VBox spacing="8">
                            <Label text="DESCRIPTION" style="-fx-font-size: 10.5px; -fx-font-weight: 800; -fx-text-fill: #00ffc6; -fx-letter-spacing: 1px;"/>
                            <TextArea fx:id="descriptionField" promptText="Describe your workout routine in detail..." wrapText="true" prefRowCount="3"
                                      style="-fx-font-size: 13px;"/>
                        </VBox>
                        
                        <!-- Grid Fields -->
                        <GridPane hgap="16" vgap="18">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>
                            
                            <!-- Category -->
                            <VBox spacing="8" GridPane.columnIndex="0">
                                <Label text="CATEGORY" style="-fx-font-size: 10.5px; -fx-font-weight: 800; -fx-text-fill: #00ffc6; -fx-letter-spacing: 1px;"/>
                                <ComboBox fx:id="categoryField" promptText="Select type" maxWidth="Infinity"
                                          style="-fx-pref-height: 42px;"/>
                            </VBox>
                            
                            <!-- Duration -->
                            <VBox spacing="8" GridPane.columnIndex="1">
                                <Label text="DURATION" style="-fx-font-size: 10.5px; -fx-font-weight: 800; -fx-text-fill: #00ffc6; -fx-letter-spacing: 1px;"/>
                                <TextField fx:id="durationField" promptText="30"
                                            style="-fx-font-size: 13.5px; -fx-padding: 14 18;"/>
                            </VBox>
                            
                            <!-- Difficulty -->
                            <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="DIFFICULTY" style="-fx-font-size: 10.5px; -fx-font-weight: 800; -fx-text-fill: #00ffc6; -fx-letter-spacing: 1px;"/>
                                <ComboBox fx:id="difficultyField" promptText="Select level" maxWidth="Infinity"
                                          style="-fx-pref-height: 42px;"/>
                            </VBox>
                        </GridPane>
                    </VBox>
                    
                    <Separator style="-fx-background-color: linear-gradient(to right, rgba(0,255,198,0.3), rgba(103,128,255,0.3));"/>
                    
                    <!-- Action Buttons -->
                    <GridPane hgap="14" vgap="14">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        
                        <Button fx:id="addBtn" text="➕ CREATE" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                style="-fx-background-color: linear-gradient(to bottom right, #00c9a7 0%, #00ffc6 100%); -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 14; -fx-padding: 15; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,201,167,0.5), 12, 0, 0, 3); -fx-font-size: 12.5px;"/>
                        <Button fx:id="updateBtn" text="✏️ UPDATE" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"
                                style="-fx-background-color: linear-gradient(to bottom right, #6780ff 0%, #5678e9 100%); -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 14; -fx-padding: 15; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(103,128,255,0.5), 12, 0, 0, 3); -fx-font-size: 12.5px;"/>
                        <Button fx:id="deleteBtn" text="🗑️ DELETE" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                style="-fx-background-color: linear-gradient(to bottom right, #ff6b6b 0%, #ff5252 100%); -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 14; -fx-padding: 15; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(255,107,107,0.5), 12, 0, 0, 3); -fx-font-size: 12.5px;"/>
                        <Button fx:id="clearBtn" text="🔄 CLEAR" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-weight: 700; -fx-background-radius: 14; -fx-padding: 15; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1.5; -fx-border-radius: 14; -fx-font-size: 12.5px;"/>
                    </GridPane>
                    
                    <!-- Tips Section -->
                    <VBox spacing="10" style="-fx-background-color: linear-gradient(to bottom right, rgba(103,128,255,0.15), rgba(0,201,167,0.1)); -fx-background-radius: 14; -fx-padding: 16 18; -fx-border-color: rgba(103,128,255,0.25); -fx-border-width: 1; -fx-border-radius: 14;">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="💡" style="-fx-font-size: 14px;"/>
                            <Label text="Quick Tips" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #a5b4ff;"/>
                        </HBox>
                        <Label text="• Use clear, descriptive titles for easy identification
• Set realistic durations to build consistency
• Match difficulty level to your current fitness"
                               wrapText="true"
                               style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.6); -fx-line-spacing: 3px;"/>
                    </VBox>
                </VBox>
            </GridPane>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="8" style="-fx-background-color: rgba(0,0,0,0.4); -fx-padding: 14; -fx-border-color: rgba(0,255,198,0.1); -fx-border-width: 1 0 0 0;">
            <Label text="⚡" style="-fx-font-size: 12px; -fx-text-fill: #6780ff;"/>
            <Label text="Workout Studio v2.0 • Template Management System"
                   style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.4); -fx-font-weight: 500;"/>
        </HBox>
    </bottom>
</BorderPane>
