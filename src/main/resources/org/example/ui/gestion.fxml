<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.GestionController"
            prefWidth="1200"
            prefHeight="800">

    <top>
        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10 20; -fx-background-color: #2c3e50; -fx-spacing: 20;">
            <Label text="Administration - Atomic You" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Mode Admin" style="-fx-text-fill: #ecf0f1; -fx-font-style: italic;"/>
            <Button text="Déconnexion" onAction="#logout" 
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;"/>
        </HBox>
    </top>

    <center>
        <!-- Onglets -->
        <TabPane>
            <!-- TAB USER -->
            <Tab text="Gérer les utilisateurs" closable="false">
                <AnchorPane>
                    <fx:include source="user_list.fxml"
                                AnchorPane.topAnchor="0"
                                AnchorPane.bottomAnchor="0"
                                AnchorPane.leftAnchor="0"
                                AnchorPane.rightAnchor="0"/>
                </AnchorPane>
            </Tab>

            <!-- TAB RECLAMATION -->
            <Tab text="Gérer les réclamations" closable="false">
                <AnchorPane>
                    <fx:include source="reclamation_list.fxml"
                                AnchorPane.topAnchor="0"
                                AnchorPane.bottomAnchor="0"
                                AnchorPane.leftAnchor="0"
                                AnchorPane.rightAnchor="0"/>
                </AnchorPane>
            </Tab>

            <!-- TAB FITNESS (Atomic Habits - workout & progress for logged-in user) -->
            <Tab text="Fitness" closable="false">
                <AnchorPane>
                    <fx:include source="fitness/fitness_dashboard.fxml"
                                AnchorPane.topAnchor="0"
                                AnchorPane.bottomAnchor="0"
                                AnchorPane.leftAnchor="0"
                                AnchorPane.rightAnchor="0"/>
                </AnchorPane>
            </Tab>

            <!-- TAB MOTIVATION (Challenges, Coaches, Récompenses) -->
            <Tab text="Motivation" closable="false">
                <AnchorPane>
                    <fx:include source="motivation/dashboard_statistiques.fxml"
                                AnchorPane.topAnchor="0"
                                AnchorPane.bottomAnchor="0"
                                AnchorPane.leftAnchor="0"
                                AnchorPane.rightAnchor="0"/>
                </AnchorPane>
            </Tab>

        </TabPane>
    </center>

</BorderPane>
